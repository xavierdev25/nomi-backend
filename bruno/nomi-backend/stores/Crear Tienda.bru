meta {
  name: Crear Tienda
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/stores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "nombre": "Pollería El Sabor",
    "descripcion": "Las mejores pollerías del campus",
    "telefono": "999888777",
    "ownerId": {{userId}}
  }
}

vars:pre-request {
  userId: 47
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("storeId", res.body.id);
  }
}
