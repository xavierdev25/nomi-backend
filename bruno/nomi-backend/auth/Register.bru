meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Xavier",
    "apellidos": "Montaño",
    "email": "xavier@gmail.com",
    "password": "TestPass123",
    "telefono": "999999998",
    "role": "ESTUDIANTE",
    "preferences": ["pollo", "arroz chaufa", "menú ejecutivo"],
    "restrictions": ["cebolla china"],
    "budgetRange": "MEDIO",
    "cuisineTypes": ["criolla"]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("userId", res.body.id);
  }
}
