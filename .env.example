# =============================================
# Nomi Backend — Environment Variables
# Copy this file to .env and fill in real values
# =============================================

# ── Spring ─────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── PostgreSQL ─────────────────────────────
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_POOL_SIZE=10

# ── Redis ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── pgAdmin ────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your-pgadmin-password
PGADMIN_PORT=5050

# ── JWT ────────────────────────────────────
JWT_SECRET=your-256-bit-secret-key-min-32-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=nomi-backend

# ── Cloudinary ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── MercadoPago ────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=your-access-token
MERCADOPAGO_PUBLIC_KEY=your-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
MERCADOPAGO_NOTIFICATION_URL=https://your-domain.com/api/payments/webhook

# ── WebSocket ──────────────────────────────
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── CORS ───────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ────────────────────────────────
LOG_LEVEL=DEBUG
JPA_SHOW_SQL=false
HIBERNATE_LOG_LEVEL=WARN

# ── AI Service ─────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET_KEY=your-ai-service-secret-key
OLLAMA_HOST=http://host.docker.internal:11434
ALLOWED_ORIGINS=http://localhost:8080
GROQ_API_KEY=
AI_CACHE_TTL_SECONDS=300

# ── Firebase FCM ───────────────────────────
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id
