meta {
  name: Crear Producto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "nombre": "Pollo a la brasa",
    "descripcion": "1/4 de pollo con papas y ensalada",
    "precio": 12.50,
    "stock": 20,
    "categoria": "COMIDA",
    "storeId": 1
  }
}